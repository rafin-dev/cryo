fn main() {
   print hi();

   // Example of internal function, defined in the interpreter
   print internal("Hi!");

   var test = 10;
   print test;
   test = "ola";
   print test;
}

fn greet(var i, var i2) {
   print "Hi, i'm a different function!";
   print i;
   print i2;
}

fn hi() {
   print "hello";
   greet(25, 10.6);
   return "Hello, World!";
}