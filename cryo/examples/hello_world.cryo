fn main() {
   readln();
   println(hi());

   var test = 10;
   if (test < 5) {
      println(test);
   }
   else {
      println("not this time");
   }
   test = "ola";
   println(test);

   test = 10;
   test -= 2;
   println(test);

   print("Type your name: ");
   var input = readln();
   println("Hello ", input, "!");
}

fn greet(var i, var i2) {
   println("Hi, i'm a different function!");
   println(i);
   println(i2);
}

fn hi() {
   println("hello");
   greet(25, 10.6);
   return "Hello, World!";
}